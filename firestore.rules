rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Hazard reports: readable by everyone; guests may create reports too
    // (time-bound). This is a hackathon demo — swap in auth-only writes if
    // you need to protect against spam.
    match /hazards/{hazardId} {
      allow read: if true;
      allow create, update: if request.time < timestamp.date(2026, 10, 5);
    }

    // User portfolios: each signed-in user reads/writes only their own doc.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.time < timestamp.date(2026, 10, 5);
    }
  }
}